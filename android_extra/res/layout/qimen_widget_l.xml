<?xml version="1.0" encoding="utf-8"?>
<!-- 大（4×4）：迷你九宮時盤（上南下北，吉門宮加框）＋下方最多 2 項並排＋出行訣按鈕 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/qm_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/qimen_widget_bg"
    android:orientation="vertical"
    android:padding="10dp">

    <LinearLayout
        android:id="@+id/qm_w_board"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/qm_w_p4"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="1.5dp"
                android:layout_weight="1"
                android:background="@drawable/qimen_widget_cell"
                android:gravity="center"
                android:lineSpacingMultiplier="0.95"
                android:maxLines="3"
                android:textColor="#E8D9B0"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/qm_w_p9"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="1.5dp"
                android:layout_weight="1"
                android:background="@drawable/qimen_widget_cell"
                android:gravity="center"
                android:lineSpacingMultiplier="0.95"
                android:maxLines="3"
                android:textColor="#E8D9B0"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/qm_w_p2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="1.5dp"
                android:layout_weight="1"
                android:background="@drawable/qimen_widget_cell"
                android:gravity="center"
                android:lineSpacingMultiplier="0.95"
                android:maxLines="3"
                android:textColor="#E8D9B0"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/qm_w_p3"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="1.5dp"
                android:layout_weight="1"
                android:background="@drawable/qimen_widget_cell"
                android:gravity="center"
                android:lineSpacingMultiplier="0.95"
                android:maxLines="3"
                android:textColor="#E8D9B0"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/qm_w_p5"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="1.5dp"
                android:layout_weight="1"
                android:background="@drawable/qimen_widget_cell"
                android:gravity="center"
                android:lineSpacingMultiplier="0.95"
                android:maxLines="3"
                android:textColor="#E8D9B0"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/qm_w_p7"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="1.5dp"
                android:layout_weight="1"
                android:background="@drawable/qimen_widget_cell"
                android:gravity="center"
                android:lineSpacingMultiplier="0.95"
                android:maxLines="3"
                android:textColor="#E8D9B0"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/qm_w_p8"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="1.5dp"
                android:layout_weight="1"
                android:background="@drawable/qimen_widget_cell"
                android:gravity="center"
                android:lineSpacingMultiplier="0.95"
                android:maxLines="3"
                android:textColor="#E8D9B0"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/qm_w_p1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="1.5dp"
                android:layout_weight="1"
                android:background="@drawable/qimen_widget_cell"
                android:gravity="center"
                android:lineSpacingMultiplier="0.95"
                android:maxLines="3"
                android:textColor="#E8D9B0"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/qm_w_p6"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="1.5dp"
                android:layout_weight="1"
                android:background="@drawable/qimen_widget_cell"
                android:gravity="center"
                android:lineSpacingMultiplier="0.95"
                android:maxLines="3"
                android:textColor="#E8D9B0"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/qm_w_rows"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal" />

        <TextView
            android:id="@+id/qm_w_travel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:background="@drawable/qimen_widget_btn"
            android:gravity="center"
            android:maxWidth="64dp"
            android:paddingStart="8dp"
            android:paddingTop="10dp"
            android:paddingEnd="8dp"
            android:paddingBottom="10dp"
            android:textColor="#E8D9B0"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
